# Database Setup
DB_URL=jdbc:postgresql://127.0.0.1:5432/technix
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Token Setup
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=1800000
#keep jwt expiration lower for production(right now its 1,800,000 or 30min)
REFRESH_EXPIRATION=432000000

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# reCAPTCHA v2 (server-side secret, from google.com/recaptcha/admin)
RECAPTCHA_SECRET=your_recaptcha_secret_key