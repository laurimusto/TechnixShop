# Copy this file to ".env" (same folder) and run:  docker compose up --build
# The values below work out of the box for a local demo. Change the secrets for anything public.

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Only used when running the backend outside Docker; docker compose overrides it.
DB_URL=jdbc:postgresql://localhost:5432/technix

# --- JWT ---
# HMAC-SHA256 signing key, at least 32 characters. Generate your own, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-this-is-a-local-dev-secret-of-at-least-32-chars
# Lifetimes in milliseconds: access token 30 min, refresh token 5 days, reset link 30 min
JWT_EXPIRATION=1800000
REFRESH_EXPIRATION=432000000
RESET_EXPIRATION=1800000

# --- Two-factor authentication ---
# Encrypts every user's 2FA secret in the database. At least 32 characters: openssl rand -base64 32
# Changing it later makes existing 2FA setups unreadable (users would have to set 2FA up again).
TOTP_ENCRYPTION_KEY=change-me-this-is-a-local-dev-totp-key-of-32-plus-chars

# --- Frontend URL (CORS + links in emails) ---
FRONTEND_URL=http://localhost:3000

# --- Mail (Mailpit). Only used outside Docker; docker compose overrides the host. ---
MAIL_HOST=localhost
MAIL_PORT=1025

# --- reCAPTCHA v2 ---
# These are Google's official TEST keys: the checkbox always passes and shows a "testing only" note.
# For real protection create your own keys at https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# --- Google sign-in (optional) ---
# OAuth Client ID (type "Web application") from https://console.cloud.google.com/apis/credentials
# with http://localhost:3000 as an authorized JavaScript origin. Both lines use the same value.
# Without it everything works except the "Continue with Google" button.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Cloudinary (reserved for product image upload, not used yet) ---
CLOUDINARY_CLOUD_NAME=unused
CLOUDINARY_API_KEY=unused
CLOUDINARY_API_SECRET=unused
